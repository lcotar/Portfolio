# =========================================================
# .htaccess – leacotar.com
# Angular SPA (Client-Side Routing) + PHP-Kontaktformular
# =========================================================

# ----- 2. HTTPS erzwingen + 1. Angular SPA-Fallback -----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Alles auf HTTPS umleiten
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # index.html selbst nicht mehr umschreiben
  RewriteRule ^index\.html$ - [L]

  # Existiert die angefragte Datei/der Ordner wirklich (z.B. sendMail.php,
  # /img/..., /i18n/...)? Dann normal ausliefern.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Alles andere (z.B. /imprint, /privacy) an index.html weiterreichen,
  # damit der Angular Router das Routing im Browser übernehmen kann.
  RewriteRule . /index.html [L]
</IfModule>

# ----- 4. Browser-Caching -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ----- 5. Kompression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----- 6. Sicherheits-Header -----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Verzeichnis-Listing verbieten (z.B. leacotar.com/img/ soll nicht den
# kompletten Ordnerinhalt anzeigen)
Options -Indexes

# ----- 9. PHP-Einstellungen (fuer sendMail.php) -----
# Greift nur, wenn PHP als Apache-Modul (mod_php) laeuft. Laeuft PHP bei
# deinem Hoster stattdessen ueber PHP-FPM/CGI, wirft dieser Block einen
# 500-Fehler -- in dem Fall diesen Block einfach entfernen und die
# Einstellungen stattdessen im All-Inkl-KAS (PHP-Einstellungen) setzen.
<IfModule mod_php.c>
  php_flag display_errors off
  php_value error_reporting 0
</IfModule>
